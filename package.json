{
  "name": "evan-developer-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --port 8788",
    "build": "tsc --noEmit && vite build",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "miniflare": "^5.20261123.1-beta",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  }
}
