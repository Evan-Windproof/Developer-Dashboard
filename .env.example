# Copy to .dev.vars for local Pages Functions development.
APP_BASE_URL=http://localhost:8788
GITHUB_APP_SLUG=your-app-slug
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_APP_ID=your-numeric-app-id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
SESSION_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
# Set to 1 temporarily to show safe GitHub login request details in Wrangler logs.
# OAUTH_DIAGNOSTICS=1
